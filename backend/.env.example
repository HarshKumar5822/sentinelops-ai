# ─── SentinelOps AI · backend configuration ───────────────────────────
# Copy this file to `.env` and fill in your values.  NEVER commit `.env`.

# Server
PORT=8787
CORS_ORIGIN=*
RATE_LIMIT_PER_MIN=60

# ─── AI (Groq) ────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
# Recommended models from the hackathon guide: openai/gpt-oss-120b, qwen/qwen3-32b
GROQ_MODEL=openai/gpt-oss-120b
# Used automatically if the primary model errors or is rate-limited
GROQ_FALLBACK_MODEL=llama-3.3-70b-versatile
AI_TIMEOUT_MS=30000

# ─── Hindsight (optional) ─────────────────────────────────────────────
# Set HINDSIGHT_ENABLED=true to mirror memories to a real Hindsight instance
# and use it during triage.  Cloud: https://ui.hindsight.vectorize.io
HINDSIGHT_ENABLED=false
HINDSIGHT_BASE_URL=http://localhost:8888
# For Hindsight Cloud use https://api.hindsight.vectorize.io and set the key:
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=sentinelops-ai
